# ─── Core ─────────────────────────────────────────
NODE_ENV=development
PORT=8787
APP_URL=http://localhost:5173
JWT_SECRET=change-me-super-secret-jwt
TOKEN_ENC_KEY=32_byte_hex_for_aes_256_gcm_change_me_please_______________________
# Mots de passe d'accès par tenant (format : tenant:pwd1,pwd2|tenant:pwd1,pwd2)
OUIWEB_DEMO_PASSWORDS=vbweb:change-me|ouibo:change-me

# ─── MongoDB ──────────────────────────────────────
# Optional in dev: if not set, app uses the local JSON store.
MONGODB_URI=

# ─── DeepSeek ─────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ─── LinkedIn OAuth ───────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8787/api/linkedin/callback

# ─── Cloudflare (optional, for media) ─────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
